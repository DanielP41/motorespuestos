# Base de datos
DATABASE_URL=postgresql://moto_user:CHANGE_ME@db:5432/motorespuestos

# JWT
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — dominios permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# URL pública del backend (se usa para construir las URLs de imágenes subidas)
# En producción cambiar por el dominio real, ej: https://api.tudominio.com
API_BASE_URL=http://localhost:8000

# Admin inicial (solo se usa en el primer arranque)
ADMIN_INIT_PASSWORD=CHANGE_ME
