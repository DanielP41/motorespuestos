# ============================================================
# Moto Repuestos — Variables de entorno de PRODUCCIÓN
#
# Uso en el VPS:
#   cp .env.example .env
#   nano .env          ← completar todos los CHANGE_ME
#   ./deploy.sh
#
# NUNCA subir el .env a git (ya está en .gitignore)
# ============================================================

# ── Dominio ──────────────────────────────────────────────────
# Caddy obtiene el certificado SSL automáticamente (Let's Encrypt)
# Requiere que el DNS apunte al servidor ANTES del primer deploy
DOMAIN=tudominio.com

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=moto_user
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=moto_repuestos

# ── Backend / JWT ────────────────────────────────────────────
# Generar con: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ─────────────────────────────────────────────────────
# Sin barra al final. Si tenés www y sin www, separar por coma:
# ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=https://tudominio.com

# ── URLs públicas ─────────────────────────────────────────────
# URL del backend — usada para construir URLs de imágenes subidas
API_BASE_URL=https://api.tudominio.com

# URL del backend — se hornea en el bundle de Vite al compilar
VITE_API_URL=https://api.tudominio.com

# URL del frontend — usada en los emails de reset de contraseña
FRONTEND_URL=https://tudominio.com

# ── Admin inicial ─────────────────────────────────────────────
# Contraseña del usuario admin creado en el primer arranque
# Cambiarla desde el panel después del primer login
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tudominio.com
ADMIN_INIT_PASSWORD=CHANGE_ME_admin_password

# ── SMTP (reset de contraseña por email) ─────────────────────
# Dejar SMTP_HOST vacío para que el link aparezca en los logs
# en vez de enviarse por email (útil mientras no tenés SMTP).
#
# Opciones gratuitas recomendadas:
#   Brevo (brevo.com)  — 300 emails/día gratis
#   Resend (resend.com) — 100 emails/día gratis
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@tudominio.com

# ── MercadoPago ───────────────────────────────────────────────────────────────
# Credenciales en: https://www.mercadopago.com.ar/settings/account/credentials
# Usar las credenciales de PRODUCCIÓN (no las de prueba) al deployar
MP_ACCESS_TOKEN=APP_USR-...
# Secret del webhook — se genera al configurar el webhook en el panel de MP:
# MP → Tus integraciones → Webhooks → Agregar → pegar URL del webhook → copiar el secret
MP_WEBHOOK_SECRET=
